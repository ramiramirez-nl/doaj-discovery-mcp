PORT=3000
DOAJ_API_BASE_URL=https://doaj.org/api
DOAJ_REQUEST_TIMEOUT_MS=10000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=100000
ENABLE_CACHE=true
CACHE_DIR=.cache/doaj
CACHE_TTL_SECONDS=86400
MAX_RESULTS_DEFAULT=10
MAX_RESULTS_LIMIT=25
TRUST_PROXY=false
BUILD_SHA=development
DEPLOYMENT_BASE_URL=
